CREATE TABLE PodcastEntity (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    author TEXT NOT NULL,
    description TEXT,
    imageUrl TEXT,
    rssUrl TEXT NOT NULL,
    websiteUrl TEXT,
    language TEXT,
    genres TEXT,
    listenNotesId TEXT,
    genreIds TEXT,
    episodeCount INTEGER,
    isSubscribed INTEGER NOT NULL DEFAULT 0,
    lastUpdated INTEGER NOT NULL,
    createdAt INTEGER NOT NULL
);

-- Queries
selectAllPodcasts:
SELECT * FROM PodcastEntity;

selectSubscribedPodcasts:
SELECT * FROM PodcastEntity WHERE isSubscribed = 1;

selectPodcastById:
SELECT * FROM PodcastEntity WHERE id = ?;

selectPodcastByRssUrl:
SELECT * FROM PodcastEntity WHERE rssUrl = ?;

insertPodcast:
INSERT OR REPLACE INTO PodcastEntity (
    id, title, author, description, imageUrl, rssUrl, websiteUrl, 
    language, genres, listenNotesId, genreIds, episodeCount, isSubscribed, lastUpdated, createdAt
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updatePodcastSubscription:
UPDATE PodcastEntity SET isSubscribed = ?, lastUpdated = ? WHERE id = ?;

updatePodcastRssUrl:
UPDATE PodcastEntity SET rssUrl = ?, lastUpdated = ? WHERE id = ?;

updatePodcastDetails:
UPDATE PodcastEntity SET 
    title = ?, author = ?, description = ?, imageUrl = ?, 
    websiteUrl = ?, language = ?, genres = ?, lastUpdated = ? 
WHERE id = ?;

deletePodcast:
DELETE FROM PodcastEntity WHERE id = ?;

updatePodcastWithListenNotesData:
UPDATE PodcastEntity SET 
    listenNotesId = ?, 
    genreIds = ?,
    description = ?,
    episodeCount = ?,
    lastUpdated = ?
WHERE id = ?;

selectPodcastByListenNotesId:
SELECT * FROM PodcastEntity WHERE listenNotesId = ?;

deleteUnsubscribedPodcasts:
DELETE FROM PodcastEntity WHERE isSubscribed = 0;